<script>
import { computed } from "lucia";
import { clicks } from "./store.ts";

const title = "LuciaJS";
const limit = 10;
const double = computed(() => clicks.value * 2);
const isDone = computed(() => clicks.value >= limit);

export function setup(root: Element) {
  root.querySelector(".add")!.addEventListener("click", () => clicks.value++);
  root.querySelector(".reset")!.addEventListener("click", () => (clicks.value = 0));
}
</script>

<h1>{title}</h1>
<p class="status {isDone.value ? 'done' : ''}">
  Clicked {clicks} of {limit} times. Double: {double}.
</p>
<progress max={limit} value={clicks}></progress>
<p class="hint">{isDone.value ? "Limit reached" : `${limit - clicks.value} left`}</p>
<button class="add" disabled={isDone}>Add one</button>
<button class="reset" title={clicks.value === 0 ? null : "Start again"}>Reset</button>

<style>
@use "sass:color";
$accent: tomato;

:global(body) { font-family: system-ui, sans-serif; margin: 2rem; }

h1 { color: $accent; }
.status.done { color: $accent; font-weight: bold; }
.hint { opacity: 0.7; }
button {
  padding: 0.5rem 1rem;
  &:hover:not(:disabled) { background: color.adjust($accent, $lightness: 30%); }
}
</style>
