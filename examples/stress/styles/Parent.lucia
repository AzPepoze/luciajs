<script>
import { attach, type Instance } from "lucia";
import Child from "./Child.lucia";

function setup(root: Element) {
  const child: Instance = attach(Child, root.querySelector(".slot")!);
  return () => child.detach();
}
</script>

<div class="parent">
  <p class="mark">Parent</p>
  <div class="slot"></div>
</div>

<style>
.mark { outline: 2px solid rebeccapurple; }

@scoped {
  .mark { background: lightyellow; }
}
</style>
