<script>
import { props } from "lucia";

// The index mirrors the Guide sidebar's markup, so both share its styles and scripts.
interface IndexLink {
  id: string;
  name: string;
  icon: string;
}

interface IndexGroup {
  group: string;
  label: string;
  icon: string;
  color: string;
  links: IndexLink[];
}

const { groups } = props({ groups: [] as IndexGroup[] });
</script>

<EACH {groups} as={group}>
  <div class="nav-group" data-index-group={group.group} style={"--group: " + group.color}>
    <button class="nav-title" type="button" aria-expanded="true">
      <span class="group-name">
        <span class="material-symbols-rounded" aria-hidden="true">{group.icon}</span>
        {group.label}
      </span>
      <span class="material-symbols-rounded chevron" aria-hidden="true">expand_more</span>
    </button>
    <div class="nav-items">
      <div>
        <nav class="nav-links" aria-label={group.label}>
          <EACH {group.links} as={link}>
            <a href={"#" + link.id} data-ref-link={link.id}>
              <span class="material-symbols-rounded" aria-hidden="true">{link.icon}</span>
              <code class="nav-label">{link.name}</code>
            </a>
          </EACH>
        </nav>
      </div>
    </div>
  </div>
</EACH>
