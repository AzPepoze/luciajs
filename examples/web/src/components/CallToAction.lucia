<script>
import { props, variable } from "lucia";
import Sparks from "./Sparks.lucia";
import RevealTitle from "./RevealTitle.lucia";
import { spawnSparks, type Spark } from "../motion/sparks.ts";
import { pull, release } from "../motion/pointer.ts";
import { scrollBetween } from "../motion/home-scroll.ts";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
const { follow } = props({ follow: null as HTMLElement | null });

const sparks = variable<Spark[]>([]);
const confettiTones = [
  "var(--pink)",
  "var(--lemon)",
  "var(--mint)",
  "var(--sky)",
  "var(--lavender)",
];

// The text grows in as the section reaches the centre of the page.
const textScale = reduced
  ? []
  : scrollBetween(
      follow,
      { opacity: 0, scale: "0.9" },
      { opacity: 1, scale: "1" },
      [0.86, 0.98],
    );

// Confetti bursts from the pointer when it enters the section.
function celebrate(event: PointerEvent): void {
  if (reduced) return;
  const box = (event.currentTarget as HTMLElement).getBoundingClientRect();
  spawnSparks(sparks, {
    kind: "confetti",
    tones: confettiTones,
    count: 28,
    x: event.clientX - box.left,
    y: event.clientY - box.top,
    spread: 260,
    lift: 80,
    duration: 1600,
  });
}
</script>

<section class="cta-section" onpointerenter={celebrate}>
  <div class="cta-sparks" aria-hidden="true">
    <Sparks sparks={sparks} />
  </div>
  <div class="cta-content" animate={textScale}>
    <RevealTitle text="Ready to play with it?" />
    <p class="cta-text">Read the guide, then try every demo on the page.</p>
    <div class="cta-actions">
      <a
        class="button primary magnetic"
        href="/guide"
        onpointermove={pull}
        onpointerleave={release}
      >
        <span class="material-symbols-rounded" aria-hidden="true">menu_book</span>
        Read the guide
      </a>
      <a
        class="button magnetic"
        href="/reference"
        onpointermove={pull}
        onpointerleave={release}
      >
        <span class="material-symbols-rounded" aria-hidden="true">data_object</span>
        Reference
      </a>
    </div>
  </div>
</section>
