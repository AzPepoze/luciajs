<script>
import { store, props, WHEN, EASE } from "lucia";
import { scrollHint } from "../motion.ts";
import { scrollBetween } from "../motion/home-scroll.ts";
import { typingFrames } from "../motion/typing.ts";
import { pull, release } from "../motion/pointer.ts";
import HeroCounter from "./HeroCounter.lucia";
import Mascot from "./Mascot.lucia";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const { follow } = props({ follow: null as HTMLElement | null });

// Each letter drops in on its own delay. Hovering a letter wobbles it.
const letterIn = {
  0: { opacity: 0, translate: "0px 30px" },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
};
const letterWobble = {
  default: [EASE.STYLE.SINE, EASE.OUT],
  0: { rotate: "0deg" },
  0.25: { rotate: "-14deg" },
  0.5: { rotate: "10deg" },
  0.75: { rotate: "-5deg" },
  1: { rotate: "0deg" },
};

function letterMotion(index: number) {
  if (reduced) return [];
  return [
    { style: letterIn, when: WHEN.ATTACH, duration: 600, delay: 80 + index * 70 },
    { style: letterWobble, when: WHEN.HOVER, duration: 500 },
  ];
}

const letters = "LuciaJS"
  .split("")
  .map((char, index) => ({ char, motion: letterMotion(index) }));

const fadeIn = {
  0: { opacity: 0 },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1 }],
};
const ctaIn = {
  0: { opacity: 0, translate: "0px 16px" },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
};

const eyebrowMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 500 };
const taglineMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 600 };
const installMotion = { style: ctaIn, when: WHEN.ATTACH, duration: 600, delay: 700 };
const ctaMotion = { style: ctaIn, when: WHEN.ATTACH, duration: 600, delay: 800 };
const noteMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 900 };

// The text drifts up and fades over the first part of the page, as the hero scrolls away.
const heroDrift = scrollBetween(
  follow,
  { opacity: 1, translate: "0 0" },
  { opacity: 0.1, translate: "0 -14vh" },
  [0, 0.18],
);

// Floating badges bob at their own pace.
const badgeBob = (delay: number) =>
  reduced
    ? []
    : {
        style: {
          default: [EASE.STYLE.SINE, EASE.INOUT],
          0: { translate: "0 0" },
          1: { translate: "0 -10px" },
        },
        loop: true,
        backAndForth: true,
        duration: 2600,
        delay,
      };

const hintMotion = {
  style: scrollHint,
  loop: true,
  backAndForth: true,
  duration: 1600,
};

const phrases = [
  "Single-file components, stores and scoped SCSS.",
  "Stores that update only what changed.",
  "A Bun-native UI framework.",
];
const typed = store("");
const frames = typingFrames(phrases);

// Types the taglines one after another. Reduced motion shows the first one whole.
function setup() {
  if (reduced) {
    typed.value = phrases[0];
    return;
  }
  let frame = 0;
  const timer = setInterval(() => {
    typed.value = frames[frame];
    frame = (frame + 1) % frames.length;
  }, 55);
  return () => clearInterval(timer);
}
</script>

<section class="hero" id="top">
  <div class="hero-inner" animate={heroDrift}>
    <p class="eyebrow-row">
      <span class="eyebrow" animate={eyebrowMotion}>A Bun-native UI framework</span>
      <Mascot />
    </p>
    <h1 class="hero-title" aria-label="LuciaJS">
      <EACH {letters} as="{letter}">
        <span class="letter" aria-hidden="true" animate={letter.motion}>
          {letter.char}
        </span>
      </EACH>
    </h1>
    <p class="tagline" animate={taglineMotion}>
      <span class="typed">{typed}</span><span class="caret" aria-hidden="true"></span>
    </p>
    <div class="install" animate={installMotion}>
      <span class="prompt" aria-hidden="true">!</span>
      <code>Coming soon — no release yet</code>
    </div>
    <div class="cta" animate={ctaMotion}>
      <a
        class="button primary magnetic"
        href="/guide"
        onpointermove={pull}
        onpointerleave={release}
      >
        <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
        Get started
      </a>
      <a
        class="button magnetic"
        href="/guide#first-demo-group"
        onpointermove={pull}
        onpointerleave={release}
      >
        <span class="material-symbols-rounded" aria-hidden="true">play_circle</span>
        View demos
      </a>
      <a
        class="button magnetic"
        href="https://github.com/AzPepoze/luciajs"
        target="_blank"
        rel="noopener noreferrer"
        onpointermove={pull}
        onpointerleave={release}
      >
        <svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91
              .58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36
              -3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7
              1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75
              .4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28
              1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9
              10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23
              2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25
              5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67
              .8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
            fill="currentColor"
          />
        </svg>
        GitHub
      </a>
    </div>
    <HeroCounter />
    <p class="wip-note" animate={noteMotion}>
      LuciaJS is under active development and has no release yet.
      APIs and markup may change without notice.
    </p>
  </div>
  <span class="float-badge b1" aria-hidden="true" animate={badgeBob(0)}>store</span>
  <span class="float-badge b2" aria-hidden="true" animate={badgeBob(400)}>EACH</span>
  <span class="float-badge b3" aria-hidden="true" animate={badgeBob(800)}>animate</span>
  <span class="float-badge b4" aria-hidden="true" animate={badgeBob(1200)}>bind</span>
  <a
    class="scroll-hint"
    href="#features"
    aria-label="Scroll to features"
    animate={hintMotion}
  >
    <span class="material-symbols-rounded" aria-hidden="true">keyboard_arrow_down</span>
  </a>
</section>
