              10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23
              2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25
              5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67
              .8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
            fill="currentColor"
          />
        </svg>
        GitHub
      </a>
    </div>
    <p class="wip-note" animate={noteMotion}>
      LuciaJS is under active development and has no release yet.
      APIs and markup may change without notice.
    </p>
  </div>
  <a
    class="scroll-hint"
    href="#features"
    aria-label="Scroll to features"
    animate={hintMotion}
  >
    <span class="material-symbols-rounded" aria-hidden="true">keyboard_arrow_down</span>
  </a>
</section>
