<script>
import { variable, props, WHEN, EASE } from "lucia";
import { homePath, pageLink } from "../page-link.ts";
import { scrollHint } from "../motion.ts";
import { scrollBetween } from "../motion/home-scroll.ts";
import { typingFrames } from "../motion/typing.ts";
import { pull, release } from "../motion/pointer.ts";
import Mascot from "./Mascot.lucia";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const { follow } = props({ follow: null as HTMLElement | null });

// Each letter drops in on its own delay. Hovering a letter wobbles it.
const letterIn = {
  0: { opacity: 0, translate: "0px 30px" },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
};
const letterWobble = {
  default: [EASE.STYLE.SINE, EASE.OUT],
  0: { rotate: "0deg" },
  0.25: { rotate: "-14deg" },
  0.5: { rotate: "10deg" },
  0.75: { rotate: "-5deg" },
  1: { rotate: "0deg" },
};

function letterMotion(index: number) {
  if (reduced) return [];
  return [
    { style: letterIn, when: WHEN.ATTACH, duration: 600, delay: 80 + index * 70 },
    { style: letterWobble, when: WHEN.HOVER, duration: 500 },
  ];
}

const letters = "LuciaJS"
  .split("")
  .map((char, index) => ({ char, motion: letterMotion(index) }));

const fadeIn = {
  0: { opacity: 0 },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1 }],
};
const ctaIn = {
  0: { opacity: 0, translate: "0px 16px" },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
};

const eyebrowMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 500 };
const taglineMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 600 };
const installMotion = { style: ctaIn, when: WHEN.ATTACH, duration: 600, delay: 700 };
const ctaMotion = { style: ctaIn, when: WHEN.ATTACH, duration: 600, delay: 800 };
const noteMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 900 };

// The text drifts up and fades over the first part of the page, as the hero scrolls away.
const heroDrift = reduced
  ? []
  : scrollBetween(
      follow,
      { opacity: 1, translate: "0 0" },
      { opacity: 0.1, translate: "0 -14vh" },
      [0, 0.18],
    );

// The title moves faster than the rest of the hero, so the two separate as you scroll.
const titleDrift = reduced
  ? []
  : scrollBetween(follow, { translate: "0 0" }, { translate: "0 -24vh" }, [0, 0.2]);

const hintMotion = {
  style: scrollHint,
  loop: true,
  backAndForth: true,
  duration: 1600,
};

const phrases = [
  "Single-file components, variables and scoped SCSS.",
  "Variables that update only what changed.",
  "A Bun-native UI framework.",
];
const typed = variable("");
const frames = typingFrames(phrases);

// Types the taglines one after another. Reduced motion shows the first one whole.
function setup() {
  if (reduced) {
    typed.value = phrases[0];
    return;
  }
  let frame = 0;
  const timer = setInterval(() => {
    typed.value = frames[frame];
    frame = (frame + 1) % frames.length;
  }, 55);
  return () => clearInterval(timer);
}
</script>

<section class="hero" id="top">
  <div class="hero-inner" animate={heroDrift}>
    <p class="eyebrow-row">
      <span class="eyebrow" animate={eyebrowMotion}>A Bun-native UI framework</span>
      <Mascot />
    </p>
    <h1 class="hero-title" aria-label="LuciaJS" animate={titleDrift}>
      <EACH {letters} as="{letter}">
        <span class="letter" aria-hidden="true" animate={letter.motion}>
          {letter.char}
        </span>
      </EACH>
    </h1>
    <p class="tagline" animate={taglineMotion}>
      <span class="typed">{typed}</span><span class="caret" aria-hidden="true"></span>
    </p>
    <div class="install" animate={installMotion}>
      <span class="prompt" aria-hidden="true">!</span>
      <code>Coming soon — no release yet</code>
    </div>
    <div class="cta" animate={ctaMotion}>
      <a
        class="button rainbow magnetic"
        href="/guide"
        onpointermove={pull}
        onpointerleave={release}
      >
        <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
        Get started
      </a>
    </div>
    <p class="wip-note" animate={noteMotion}>
      LuciaJS is under active development and has no release yet.
      APIs and markup may change without notice.
    </p>
  </div>
  <a
    class="scroll-hint"
    href={pageLink(homePath, "features")}
    aria-label="Scroll to features"
    animate={hintMotion}
  >
    <span class="material-symbols-rounded" aria-hidden="true">keyboard_arrow_down</span>
  </a>
</section>
