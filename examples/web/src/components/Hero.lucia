<script>
import { WHEN, EASE, EDGE, SCROLL_AT } from "lucia";
import { scrollHint } from "../motion.ts";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const titleIn = {
  0: { opacity: 0, translate: "0px 24px" },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
};

const ctaIn = {
  0: { opacity: 0, translate: "0px 16px" },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
};

const fadeIn = {
  0: { opacity: 0 },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1 }],
};

const titleMotion = { style: titleIn, when: WHEN.ATTACH, duration: 700 };
const eyebrowMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 50 };
const taglineMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 150 };
const installMotion = { style: ctaIn, when: WHEN.ATTACH, duration: 600, delay: 250 };
const ctaMotion = { style: ctaIn, when: WHEN.ATTACH, duration: 600, delay: 350 };
const noteMotion = { style: fadeIn, when: WHEN.ATTACH, duration: 600, delay: 450 };

// The layers lift at different speeds as the hero scrolls past.
const scrolled = {
  when: WHEN.SCROLL,
  more: { start: { element: EDGE.TOP, window: EDGE.TOP }, end: SCROLL_AT.LEAVE },
};
const backLift = { 0: { translate: "0px 0px" }, 1: { translate: "0px -12vh" } };
const sparkleLift = { 0: { translate: "0px 0px" }, 1: { translate: "0px -25vh" } };
const petalLift = { 0: { translate: "0px 0px" }, 1: { translate: "0px -40vh" } };

const backMotion = reduced ? [] : { ...scrolled, style: backLift };
const sparkleMotion = reduced ? [] : { ...scrolled, style: sparkleLift };
const petalMotion = reduced ? [] : { ...scrolled, style: petalLift };

const hintMotion = {
  style: scrollHint,
  loop: true,
  backAndForth: true,
  duration: 1600,
};
</script>

<section class="hero">
  <div class="hero-bg" aria-hidden="true" animate={backMotion}></div>
  <div class="petals" aria-hidden="true" animate={petalMotion}>
    <span
      class="petal"
      style="--left: 6%; --size: 14px; --delay: -4s; --duration: 14s; --drift: 30px"
    ></span>
    <span
      class="petal"
      style="--left: 16%; --size: 10px; --delay: -9s; --duration: 18s; --drift: -24px"
    ></span>
    <span
      class="petal"
      style="--left: 27%; --size: 12px; --delay: -2s; --duration: 16s; --drift: 18px"
    ></span>
    <span
      class="petal"
      style="--left: 38%; --size: 16px; --delay: -12s; --duration: 20s; --drift: -36px"
    ></span>
    <span
