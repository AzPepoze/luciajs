      style="--left: 49%; --size: 9px; --delay: -6s; --duration: 13s; --drift: 22px"
    ></span>
    <span
      class="petal"
      style="--left: 58%; --size: 13px; --delay: -15s; --duration: 19s; --drift: -18px"
    ></span>
    <span
      class="petal"
      style="--left: 67%; --size: 11px; --delay: -1s; --duration: 15s; --drift: 28px"
    ></span>
    <span
      class="petal"
      style="--left: 76%; --size: 15px; --delay: -8s; --duration: 21s; --drift: -30px"
    ></span>
    <span
      class="petal"
      style="--left: 84%; --size: 10px; --delay: -11s; --duration: 17s; --drift: 20px"
    ></span>
    <span
      class="petal"
      style="--left: 91%; --size: 12px; --delay: -5s; --duration: 14s; --drift: -22px"
    ></span>
    <span
      class="petal"
      style="--left: 12%; --size: 8px; --delay: -13s; --duration: 12s; --drift: 16px"
    ></span>
    <span
      class="petal"
      style="--left: 72%; --size: 9px; --delay: -3s; --duration: 16s; --drift: -14px"
    ></span>
  </div>
  <div class="sparkle-layer" aria-hidden="true" animate={sparkleMotion}>
    <svg class="sparkle s1" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 0 L14.5 9.5 L24 12 L14.5 14.5 L12 24 L9.5 14.5 L0 12 L9.5 9.5 Z"
        fill="currentColor"
      />
    </svg>
    <svg class="sparkle s2" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 0 L14.5 9.5 L24 12 L14.5 14.5 L12 24 L9.5 14.5 L0 12 L9.5 9.5 Z"
        fill="currentColor"
      />
    </svg>
    <svg class="sparkle s3" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 0 L14.5 9.5 L24 12 L14.5 14.5 L12 24 L9.5 14.5 L0 12 L9.5 9.5 Z"
        fill="currentColor"
      />
    </svg>
    <svg class="sparkle s4" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 0 L14.5 9.5 L24 12 L14.5 14.5 L12 24 L9.5 14.5 L0 12 L9.5 9.5 Z"
        fill="currentColor"
      />
    </svg>
  </div>
  <div class="hero-inner">
    <h1 class="hero-title" animate={titleMotion}>LuciaJS</h1>
    <p class="eyebrow" animate={eyebrowMotion}>A Bun-native UI framework</p>
    <p class="tagline" animate={taglineMotion}>
      Single-file components, stores and scoped SCSS.
    </p>
    <div class="install" animate={installMotion}>
      <span class="prompt" aria-hidden="true">!</span>
      <code>Coming soon — no release yet</code>
    </div>
    <div class="cta" animate={ctaMotion}>
      <a class="button primary" href="/guide">
        <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
        Get started
      </a>
      <a class="button" href="/guide#first-demo-group">
        <span class="material-symbols-rounded" aria-hidden="true">play_circle</span>
        View demos
      </a>
      <a
        class="button"
        href="https://github.com/AzPepoze/luciajs"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91
              .58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36
