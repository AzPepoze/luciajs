<script>
import { props } from "lucia";
import { scrollBetween } from "../motion/home-scroll.ts";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const { text, follow, part } = props({
  text: "",
  follow: null as HTMLElement | null,
  part: [0, 1] as [number, number],
});

const wordFrom = { opacity: 0, translate: "0 18px" };
const wordTo = { opacity: 1, translate: "0 0" };

// Each word gets a slice of the part that overlaps its neighbours.
function wordPart(index: number, count: number): [number, number] {
  const [from, to] = part.value;
  const step = (to - from) / (count + 1);
  const start = from + index * step;
  return [start, start + 2 * step];
}

const pieces = text.value.split(" ");

// Each word rises in turn as the page scrolls through the part.
const words = pieces.map((word, index) => ({
  word,
  motion: reduced
    ? []
    : scrollBetween(follow, wordFrom, wordTo, wordPart(index, pieces.length)),
}));
</script>

<h2 class="reveal-title">
  <EACH {words} as="{item}">
    <span class="reveal-word" animate={item.motion}>{item.word}</span>
  </EACH>
</h2>
