<script>
import { EASE } from "lucia";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const words = [
  "Variables",
  "Single-file .lucia",
  "Scoped SCSS",
  "animate",
  "EACH",
  "IF",
  "bind",
  "onclick",
  "Bun native",
  "Props",
];

// The list is doubled, so moving it by half its width loops with no gap.
const chips = [...words, ...words].map((text, id) => ({ id, text }));

const scroll = reduced
  ? []
  : {
      style: {
        default: [EASE.STYLE.LINEAR, EASE.INOUT],
        0: { translate: "0% 0%" },
        1: { translate: "-50% 0%" },
      },
      loop: true,
      duration: 30000,
    };
</script>

<section class="marquee" aria-label="Feature keywords">
  <div class="marquee-track" animate={scroll}>
    <EACH {chips} as="{chip}" key="{chip.id}">
      <span class="chip">{chip.text}</span>
    </EACH>
  </div>
</section>
