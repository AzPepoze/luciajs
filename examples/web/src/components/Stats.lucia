<script>
import { props, variable } from "lucia";
import RevealTitle from "./RevealTitle.lucia";
import { catalog } from "../catalog.ts";
import { countUp } from "../motion/count.ts";
import { scrollBetween } from "../motion/home-scroll.ts";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
const { follow } = props({ follow: null as HTMLElement | null });

// Real numbers from this site's own data: the API entries and the live demos.
const demoCount = Object.values(catalog).flatMap((entry) => entry.demos ?? []).length;
const entryCount = Object.keys(catalog).length;

// The title slides in from the right, opposite to the Features title.
const titleSlide = reduced
  ? []
  : scrollBetween(
      follow,
      { opacity: 0, translate: "40vw 0" },
      { opacity: 1, translate: "0 0" },
      [0.7, 0.8],
    );

// Each number floats up at its own pace.
function floatMotion(index: number) {
  if (reduced) return [];
  const start = { translate: "0 24px" };
  const end = { translate: "0 -12px" };
  return scrollBetween(follow, start, end, [0.76 + index * 0.04, 0.92]);
}

const stats = [
  {
    value: variable(0),
    target: entryCount,
    label: "API entries documented",
    motion: floatMotion(0),
  },
  { value: variable(0), target: demoCount, label: "live demos", motion: floatMotion(1) },
];

function setup(root: Element) {
  const observer = new IntersectionObserver(
    (entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      for (const stat of stats) countUp(stat.value, stat.target);
    },
    { threshold: 0.5 },
  );
  observer.observe(root.querySelector(".stats")!);
  return () => observer.disconnect();
}
</script>

<section class="stats-section">
  <div animate={titleSlide}>
    <RevealTitle text="Made with LuciaJS" follow={follow} part={[0.7, 0.8]} />
  </div>
  <div class="stats">
    <EACH {stats} as="{stat}">
      <div class="stat">
        <p class="stat-number" animate={stat.motion}>{stat.value}</p>
        <p class="stat-label">{stat.label}</p>
      </div>
    </EACH>
  </div>
</section>
