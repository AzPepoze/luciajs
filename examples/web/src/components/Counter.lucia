<script>
import { computed } from "lucia";
import { clicks, theme } from "../store.ts";

const title = "Live demo";
const limit = 10;
const double = computed(() => clicks.value * 2);
const isDone = computed(() => clicks.value >= limit);

export function setup(root: Element) {
  const add = root.querySelector(".add")!;
  const reset = root.querySelector(".reset")!;
  const onAdd = () => clicks.value++;
  const onReset = () => (clicks.value = 0);
  add.addEventListener("click", onAdd);
  reset.addEventListener("click", onReset);
  return () => {
    add.removeEventListener("click", onAdd);
    reset.removeEventListener("click", onReset);
  };
}
</script>

<section id="counter" class="counter" data-theme={theme}>
  <h2>{title}</h2>
  <p class="status {isDone.value ? 'done' : ''}">
    Clicked {clicks} of {limit} times. Double: {double}.
  </p>
  <progress max={limit} value={clicks}></progress>
  <p class="hint">{isDone.value ? "Limit reached" : `${limit - clicks.value} left`}</p>
  <div class="actions">
    <button class="add" disabled={isDone}>Add one</button>
    <button class="reset" title={clicks.value === 0 ? null : "Start again"}>Reset</button>
  </div>
</section>

<style>
@use "../styles/theme" as theme;
$alarm: tomato;

.counter {
  @include theme.vars;
  max-width: 560px;
  margin: 0 auto;
  padding: clamp(2rem, 6vw, 3.5rem) clamp(1rem, 5vw, 2rem);
  background: var(--bg);
  color: var(--fg);
  text-align: center;

  h2 { margin: 0 0 1rem; font-size: 1.75rem; }

  .status {
    font-size: 1.1rem;
    &.done { color: $alarm; font-weight: 700; }
  }

  progress {
    width: 100%;
    height: 0.6rem;
    margin: 0.5rem 0 0.25rem;
    accent-color: theme.$accent;
  }

  .hint { color: var(--muted); margin: 0 0 1.5rem; }

  .actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }

  button {
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    color: var(--fg);
    font: inherit;
    cursor: pointer;

    &:hover:not(:disabled) { border-color: theme.$accent; color: theme.$accent; }
    &:disabled { opacity: 0.45; cursor: not-allowed; }
  }
}
</style>
