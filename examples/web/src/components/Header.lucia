<script>
import { computed } from "lucia";
import { theme } from "../store.ts";

const title = "Paper Notes";
const label = computed(() => (theme.value === "light" ? "Dark mode" : "Light mode"));

export function setup(root: Element) {
  const button = root.querySelector(".theme")!;
  const toggle = () => (theme.value = theme.value === "light" ? "dark" : "light");
  button.addEventListener("click", toggle);
  return () => button.removeEventListener("click", toggle);
}
</script>

<header class="top" data-theme={theme}>
  <a class="brand" href="#top">{title}</a>
  <nav>
    <a href="#features">Features</a>
    <a href="#counter">Demo</a>
    <a href="#signup">Sign up</a>
  </nav>
  <button class="theme" type="button">{label}</button>
</header>

<style>
@use "../styles/theme" as theme;

.top {
  @include theme.vars;
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1rem;
  padding: 0.75rem clamp(1rem, 4vw, 2.5rem);
  background: var(--bg);
  border-bottom: 1px solid var(--line);

  .brand {
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;

    a {
      color: var(--muted);
      text-decoration: none;
      &:hover { color: var(--fg); }
    }
  }

  .theme {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--fg);
    cursor: pointer;
    &:hover { border-color: theme.$accent; }
  }
}
</style>

<style global>
html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  background: #fafaf7;
  color: #1d1d1b;
  line-height: 1.5;
}
</style>
