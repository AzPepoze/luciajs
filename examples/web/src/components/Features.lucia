<script>
import { props, EASE } from "lucia";
import { scrollBetween } from "../motion/home-scroll.ts";
import { glow } from "../motion/pointer.ts";
import FeatureCounter from "./FeatureCounter.lucia";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const bobbing = {
  0: { translate: "0px 0px" },
  1: [EASE.STYLE.SINE, EASE.INOUT, { translate: "0px -4px" }],
};

const bob = { style: bobbing, loop: true, backAndForth: true, duration: 3000 };

const { follow } = props({ follow: null as HTMLElement | null });

// The content rises into place as the page scrolls, then rests.
const contentDrift = reduced
  ? []
  : scrollBetween(follow, { translate: "0 6vh" }, { translate: "0 0" }, [0.3, 0.75]);

// The title slides in from the left as the section arrives.
const titleSlide = reduced
  ? []
  : scrollBetween(
      follow,
      { opacity: 0, translate: "-40vw 0" },
      { opacity: 1, translate: "0 0" },
      [0.25, 0.42],
    );

// The bar under the title swipes out once the title has landed.
const swipeMotion = reduced
  ? []
  : scrollBetween(follow, { scale: "0 1" }, { scale: "1 1" }, [0.3, 0.38]);

// Each card fades up, tilts and grows into place, a little later than the one before it.
function cardMotion(index: number) {
  if (reduced) return [];
  const start = {
    opacity: 0,
    translate: "0 24px",
    rotate: `${index % 2 ? 2 : -2}deg`,
    scale: "0.96",
  };
  const end = { opacity: 1, translate: "0 0", rotate: "0deg", scale: "1" };
  const from = 0.12 + index * 0.02;
  return scrollBetween(follow, start, end, [from, from + 0.2]);
}

const badgeSnippet = '<badge label={mail} tone="warn" />';
const helloSnippet = "<p>Hi {name}</p>";

</script>

<section class="features" id="features">
  <div class="features-inner" animate={contentDrift}>
    <h2 class="section-title" animate={titleSlide}>
      <span class="swipe">
        <span class="swipe-bar" animate={swipeMotion}></span>Features
      </span>
    </h2>
    <div class="feature-grid">
      <article
        class="feature-card feature-card--wide"
        onpointermove={glow}
        style="--tone: var(--pink)"
        animate={cardMotion(0)}
      >
        <span class="sticker">Core</span>
        <span class="card-sparkle" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path
              d="M12 0 L14.5 9.5 L24 12 L14.5 14.5 L12 24 L9.5 14.5 L0 12 L9.5 9.5 Z"
              fill="currentColor"
            />
          </svg>
        </span>
        <div class="feature-head">
          <span class="feature-icon">
            <span class="blob" animate={bob} aria-hidden="true"></span>
            <span class="material-symbols-rounded" aria-hidden="true">bolt</span>
          </span>
          <h3>Variables</h3>
        </div>
        <p>Only the text and attributes that read a changed variable are updated.</p>
        <div class="feature-demo">
          <FeatureCounter />
        </div>
        <pre class="snippet"><code data-lang="typescript">const count = variable(0);
const double = variable.compute(() =&gt; count.value * 2);
count.value++;</code></pre>
      </article>
      <article
        class="feature-card"
        onpointermove={glow}
        style="--tone: var(--lavender)"
        animate={cardMotion(1)}
      >
        <span class="sticker">Format</span>
        <div class="feature-head">
          <span class="feature-icon">
            <span class="blob" animate={bob} aria-hidden="true"></span>
            <span class="material-symbols-rounded" aria-hidden="true">description</span>
          </span>
          <h3>Single-file .lucia</h3>
        </div>
        <p>Script, markup and styles live in one file.</p>
        <pre class="snippet"><code data-lang="lucia">&lt;script&gt;
import {"{"} variable {"}"} from "lucia";
&lt;/script&gt;
&lt;p&gt;Hi {"{"}name{"}"}&lt;/p&gt;</code></pre>
      </article>
      <article
        class="feature-card"
        onpointermove={glow}
        style="--tone: var(--mint)"
        animate={cardMotion(2)}
      >
        <span class="sticker">Components</span>
        <div class="feature-head">
          <span class="feature-icon">
            <span class="blob" animate={bob} aria-hidden="true"></span>
            <span class="material-symbols-rounded" aria-hidden="true">input</span>
          </span>
          <h3>Props and children</h3>
        </div>
        <p>Pass values as attributes. Each prop is a variable.</p>
        <pre class="snippet"><code data-lang="lucia">{badgeSnippet}</code></pre>
      </article>
      <article
        class="feature-card"
        onpointermove={glow}
        style="--tone: var(--sky)"
        animate={cardMotion(3)}
      >
        <span class="sticker">Styling</span>
        <div class="feature-head">
          <span class="feature-icon">
            <span class="blob" animate={bob} aria-hidden="true"></span>
            <span class="material-symbols-rounded" aria-hidden="true">palette</span>
          </span>
          <h3>Scoped SCSS</h3>
        </div>
        <p>Styles stay with their component.</p>
        <pre class="snippet"><code data-lang="lucia">&lt;style scoped&gt;
.card {"{"} padding: 1rem; {"}"}
&lt;/style&gt;</code></pre>
      </article>
      <article
        class="feature-card"
        onpointermove={glow}
        style="--tone: var(--lemon)"
        animate={cardMotion(4)}
      >
        <span class="sticker">Tooling</span>
        <div class="feature-head">
          <span class="feature-icon">
            <span class="blob" animate={bob} aria-hidden="true"></span>
            <span class="material-symbols-rounded" aria-hidden="true">
              rocket_launch
            </span>
          </span>
          <h3>Bun native</h3>
        </div>
        <p>The compiler is a Bun plugin. No extra build tool to set up.</p>
        <pre class="snippet"><code data-lang="none">bun install
bun dev</code></pre>
      </article>
      <article
        class="feature-card"
        onpointermove={glow}
        style="--tone: var(--pink)"
        animate={cardMotion(5)}
      >
        <span class="sticker">Editor</span>
        <div class="feature-head">
          <span class="feature-icon">
            <span class="blob" animate={bob} aria-hidden="true"></span>
            <span class="material-symbols-rounded" aria-hidden="true">code_blocks</span>
          </span>
          <h3>VS Code extension</h3>
        </div>
        <p>Syntax highlighting for <code>.lucia</code> files.</p>
        <pre class="snippet"><code data-lang="lucia">{helloSnippet}</code></pre>
      </article>
    </div>
  </div>
</section>
