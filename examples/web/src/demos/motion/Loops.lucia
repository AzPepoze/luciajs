<script>
import { EASE, TRANSITION } from "lucia";

const spin = {
  0: { rotate: "0deg" },
  1: [TRANSITION.LINEAR, EASE.INOUT, { rotate: "360deg" }],
};

const fade = {
  0: [TRANSITION.QUART, EASE.INOUT, { opacity: 1 }],
  1: [TRANSITION.QUART, EASE.INOUT, { opacity: 0.3 }],
};

const spinLoop = { animation: spin, loop: true, duration: 3000 };
const fadeLoop = { animation: fade, loop: true, duration: 1200 };
</script>

<div class="motion-stage">
  <p>Two animations on one square. The fade has its own speed.</p>
  <div class="square" animate={[spinLoop, fadeLoop]}></div>
</div>

<style>
.motion-stage {
  display: grid;
  justify-items: start;
  gap: 1rem;
  color: var(--fg);

  p {
    margin: 0;
  }

  .square {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 14px;
    background: var(--sky);
  }
}
</style>
