<script>
import { EASE, TRANSITION } from "lucia";

// Three keys: the color and size change at 0, at 0.5 and at 1.
const pulse = {
  0: { backgroundColor: "#ffb7d5", scale: "1" },
  0.5: [TRANSITION.QUART, EASE.OUT, { backgroundColor: "#c9b6ff", scale: "1.3" }],
  1: [TRANSITION.QUART, EASE.INOUT, { backgroundColor: "#aef0d8", scale: "1" }],
};
</script>

<div class="motion-stage">
  <div
    class="dot"
    animate={{ animation: pulse, loop: true, backAndForth: true, duration: 2400 }}
  ></div>
</div>

<style>
.motion-stage {
  display: grid;
  place-items: center;
  min-height: 6rem;

  .dot {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
  }
}
</style>
