<script>
import { computed, signal } from "lucia";

const name = signal("Ada");
const count = signal(3);
const greeting = computed(() => `Hello, ${name.value}!`);
const limit = 10;
const raw = "<b>not bold</b>";
const nothing = null;

export function setup(root: Element) {
  const rename = root.querySelector(".rename")!;
  const bump = root.querySelector(".bump")!;
  const onRename = () => (name.value = name.value === "Ada" ? "Grace" : "Ada");
  const onBump = () => count.value++;
  rename.addEventListener("click", onRename);
  bump.addEventListener("click", onBump);
  return () => {
    rename.removeEventListener("click", onRename);
    bump.removeEventListener("click", onBump);
  };
}
</script>

<div class="text-demo">
  <p>Signal: {name}</p>
  <p>Expression with .value: {count.value * 2}</p>
  <p>Computed: {greeting}</p>
  <p>Plain const, never changes: {limit}</p>
  <p>Inserted as text: {raw}</p>
  <p>null renders nothing: [{nothing}]</p>
  <div class="actions">
    <button class="rename" type="button">Rename</button>
    <button class="bump" type="button">Add 1 to count</button>
  </div>
</div>

<style>
@use "../styles/demo" as demo;

.text-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .actions {
    @include demo.row;
    margin-top: 0.5rem;
  }

  button {
    @include demo.button;
  }
}
</style>
