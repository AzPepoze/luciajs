<script>
import { attach, type Instance } from "lucia";
import Child from "./StyleChild.lucia";

export function setup(root: Element) {
  const instance: Instance = attach(Child, root.querySelector(".slot")!);
  return () => instance.detach();
}
</script>

<div class="style-parent">
  <p class="note">Parent note: underlined by the @scoped rule</p>
  <p>Parent paragraph: red by the tree rule</p>
  <div class="slot"></div>
</div>

<style>
@use "../styles/theme" as theme;

.style-parent {
  display: grid;
  gap: 0.5rem;
  padding: 0.75rem;
  border-radius: 10px;
  background: var(--bg);
  color: var(--fg);
}

p { color: theme.$accent; }

@scoped {
  .note { text-decoration: underline; }
}
</style>
