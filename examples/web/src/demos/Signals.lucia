<script>
import { computed, signal } from "lucia";

const width = signal(4);
const height = signal(3);
const area = computed(() => width.value * height.value);
const fill = computed(() => Math.min(area.value * 4, 100));
const size = computed(() => (area.value > 12 ? "Large" : "Small"));

export function setup(root: Element) {
  const wider = root.querySelector(".wider")!;
  const taller = root.querySelector(".taller")!;
  const reset = root.querySelector(".reset")!;
  const onWider = () => width.value++;
  const onTaller = () => height.value++;
  const onReset = () => {
    width.value = 4;
    height.value = 3;
  };
  wider.addEventListener("click", onWider);
  taller.addEventListener("click", onTaller);
  reset.addEventListener("click", onReset);
  return () => {
    wider.removeEventListener("click", onWider);
    taller.removeEventListener("click", onTaller);
    reset.removeEventListener("click", onReset);
  };
}
</script>

<div class="signals-demo">
  <p>Width {width}, height {height}</p>
  <p>Area, a computed of both: {area}</p>
  <p>Size, a computed of the area: {size}</p>
  <div class="bar"><span style="width: {fill}%"></span></div>
  <div class="actions">
    <button class="wider" type="button">Wider</button>
    <button class="taller" type="button">Taller</button>
    <button class="reset" type="button">Reset</button>
  </div>
</div>

<style>
@use "../styles/demo" as demo;

.signals-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .bar {
    height: 0.6rem;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;

    span {
      display: block;
      height: 100%;
      background: var(--accent);
      transition: width 0.2s ease;
    }
  }

  .actions {
    @include demo.row;
    margin-top: 0.5rem;
  }

  button {
    @include demo.button;
  }
}
</style>
