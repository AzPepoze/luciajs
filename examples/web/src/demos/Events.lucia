<script>
import { computed, signal } from "lucia";

const limit = 5;
const count = signal(0);
const name = signal("");
const done = computed(() => count.value >= limit);
const greeting = computed(() => name.value.trim() || "stranger");

export function setup(root: Element) {
  const add = root.querySelector(".add")!;
  const reset = root.querySelector(".reset")!;
  const input = root.querySelector<HTMLInputElement>(".name")!;
  const onAdd = () => count.value++;
  const onReset = () => (count.value = 0);
  const onInput = () => (name.value = input.value);
  add.addEventListener("click", onAdd);
  reset.addEventListener("click", onReset);
  input.addEventListener("input", onInput);
  return () => {
    add.removeEventListener("click", onAdd);
    reset.removeEventListener("click", onReset);
    input.removeEventListener("input", onInput);
  };
}
</script>

<div class="events">
  <p class="status {done.value ? 'done' : ''}">Clicked {count} of {limit} times.</p>
  <progress max={limit} value={count}></progress>
  <p class="hint">{done.value ? "Limit reached" : `${limit - count.value} left`}</p>
  <div class="actions">
    <button class="add" type="button" disabled={done}>Add one</button>
    <button class="reset" type="button" title={count.value === 0 ? null : "Start again"}>Reset</button>
  </div>
  <label class="name-field">
    Name
    <input class="name" type="text" placeholder="Type a name" />
  </label>
  <p>Hello, {greeting}!</p>
</div>

<style>
@use "../styles/demo" as demo;
$alarm: tomato;

.events {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .status.done { color: $alarm; font-weight: 700; }

  progress {
    width: 100%;
    height: 0.6rem;
    accent-color: var(--accent);
  }

  .hint { color: var(--muted); }

  .actions {
    @include demo.row;
    margin: 0.25rem 0;
  }

  button {
    @include demo.button;
  }

  .name-field {
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
  }

  input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
  }
}
</style>
