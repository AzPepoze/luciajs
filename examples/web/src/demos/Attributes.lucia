<script>
import { computed, signal } from "lucia";

const on = signal(false);
const locked = computed(() => !on.value);
const note = computed(() => (on.value ? "Saved" : null));
const flag = computed(() => on.value);
const tone = computed(() => (on.value ? "on" : null));

export function setup(root: Element) {
  const toggle = root.querySelector(".toggle")!;
  const onToggle = () => (on.value = !on.value);
  toggle.addEventListener("click", onToggle);
  return () => toggle.removeEventListener("click", onToggle);
}
</script>

<div class="attributes-demo">
  <div class="actions">
    <button class="toggle" type="button">Toggle state</button>
    <button class="save" type="button" disabled={locked}>Save</button>
  </div>
  <p title={note}>Hover this line. Its title is set only when the state is on.</p>
  <p>Save is locked: {locked}</p>
  <p>
    <span class="chip {tone}" data-state="{tone}" data-flag={flag}>chip</span>
    Partial attributes mix text and values. Whole attributes follow the value.
  </p>
</div>

<style>
@use "../styles/demo" as demo;

.attributes-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .actions {
    @include demo.row;
    margin-bottom: 0.5rem;
  }

  button {
    @include demo.button;
  }

  .chip {
    display: inline-block;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);

    &.on { border-color: var(--accent); color: var(--accent); }
  }
}
</style>
