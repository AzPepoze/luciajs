<script>
import { store } from "lucia";
import { clicks } from "../../store.ts";

const doubled = store.from(() => clicks.value * 2);
</script>

<div class="reader">
  <p class="label">Reader</p>
  <p>Clicks: {clicks}</p>
  <p>Doubled: {doubled}</p>
</div>

<style>
.reader {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .label { font-weight: 700; }
}
