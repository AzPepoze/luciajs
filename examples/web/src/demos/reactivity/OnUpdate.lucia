<script>
import { variable } from "lucia";

const count = variable(0);
const detailsOn = variable(false);
const message = variable("");
const updates = variable(0);

// peek() reads without tracking, so this counter does not re-run the function.
function showCount() {
  updates.value = updates.peek() + 1;
  message.value = detailsOn.value ? `Count is ${count.value}` : "Details are hidden";
}

function addOne() {
  count.value++;
}

function setSameCount() {
  count.value = count.value;
}

function toggleDetails() {
  detailsOn.value = !detailsOn.value;
}

variable.onUpdate(showCount);
</script>

<div class="on-update-demo">
  <p>Count: {count}</p>
  <p>Runs so far: {updates}</p>
  <p>Message: {message}</p>
  <div class="actions">
    <button onclick={addOne} type="button">Add 1</button>
    <button onclick={setSameCount} type="button">Set the same count</button>
    <button onclick={toggleDetails} type="button">Toggle details</button>
  </div>
</div>

<style>
@use "../../styles/demo" as demo;

.on-update-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .actions {
    @include demo.row;
    margin-top: 0.5rem;
  }

  button {
    @include demo.button;
  }
}
</style>
