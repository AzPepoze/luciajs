<script>
import { store } from "lucia";

const first = store("Ada");
const last = store("Lovelace");
const full = store.from(() => `${first.value} ${last.value}`);
let renders = 0;
const updates = store(0);

// The handler writes both stores. The page still updates the text once per click.
function changeBoth() {
  renders++;
  first.value = `First ${renders}`;
  last.value = `Last ${renders}`;
  updates.value = renders;
}
</script>

<div class="batch-demo">
  <p>Full name, a derived store: {full}</p>
  <p>Clicks so far: {updates}</p>
  <div class="actions">
    <button onclick={changeBoth} type="button">Change both stores</button>
  </div>
</div>

<style>
@use "../../styles/demo" as demo;

.batch-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .actions {
    @include demo.row;
    margin: 0.5rem 0;
  }

  button {
    @include demo.button;
  }
}
</style>
