<script>
import { api, type ApiGroup } from "../../../../reference/api.ts";
import { entryIcon, groupTitles } from "../catalog.ts";
import RefCard from "../components/RefCard.lucia";
import RefIndex from "../components/RefIndex.lucia";
import { pageMotion } from "../motion/page.ts";
import { groupEntries, kindsOf } from "../reference-model.ts";

// The index and the cards read the same groups, so their order always matches the Guide's.
const groupOrder = Object.keys(groupTitles) as ApiGroup[];
const groups = groupEntries(api, groupOrder).map(({ group, entries }) => ({
  group,
  label: groupTitles[group].label,
  icon: groupTitles[group].icon,
  color: groupTitles[group].color,
  entries,
  links: entries.map((entry) => ({
    id: entry.id,
    name: entry.name,
    icon: entryIcon(entry.id),
  })),
}));
const kinds = kindsOf(api);
</script>

<div class="page-root docs reference">
  <aside class="sidebar" id="sidebar" aria-label="Reference">
    <span class="nav-indicator" aria-hidden="true"></span>
    <RefIndex groups={groups} />
  </aside>
  <div class="scrim" id="scrim" hidden></div>
  <main class="content" animate={pageMotion}>
    <h1 class="ref-page-title">Reference</h1>
    <div class="ref-tools">
      <label class="ref-search">
        <span class="material-symbols-rounded" aria-hidden="true">search</span>
        <input
          id="ref-filter"
          type="search"
          placeholder="Filter the reference  ( / )"
          aria-label="Filter the reference"
          autocomplete="off"
        />
      </label>
      <div class="ref-kinds" role="group" aria-label="Filter by kind">
        <EACH {kinds} as={kind}>
          <button class="chip kind-chip" type="button" data-kind={kind} data-ref-kind={kind} aria-pressed="false">
            {kind}
          </button>
        </EACH>
      </div>
    </div>

    <div class="ref-empty" data-ref-empty hidden>
      <p>Nothing matches your filter.</p>
      <button class="ref-clear" type="button" data-ref-clear>Clear filters</button>
    </div>

    <EACH {groups} as={group}>
      <section class="ref-group" data-ref-section data-group={group.group} style={"--group: " + group.color}>
        <h2 class="ref-group-title">{group.label}</h2>
        <EACH {group.entries} as={entry}>
          <RefCard entry={entry} />
        </EACH>
      </section>
    </EACH>
  </main>
</div>
