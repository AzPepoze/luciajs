{
  "name": "lusia",
  "private": true,
  "type": "module",
  "bin": {
    "lusia": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/runtime/index.ts",
    "./internal": "./src/runtime/internal.ts",
    "./markers": "./src/runtime/markers.ts",
    "./compiler": "./src/compiler/index.ts",
    "./bun-plugin": "./src/bun-plugin/index.ts"
  },
  "scripts": {
    "dev": "bun scripts/playground-runtime.ts && bun src/cli/index.ts dev docs",
    "dev:stress": "bun src/cli/index.ts dev examples/stress",
    "build": "bun run build:docs",
    "build:docs": "bun scripts/playground-runtime.ts && bun src/cli/index.ts build docs",
    "test": "bun test --parallel=6",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "tsc --noEmit",
    "docs:install": "cd docs && bun install",
    "check": "bun run docs:install && tsc --noEmit && bun run test && bun run build && cd editors/vscode && bun run build"
  },
  "dependencies": {
    "prettier": "3.10.1",
    "sass": "^1.80.0",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.0",
    "@types/bun": "latest",
    "playwright": "1.63.0",
    "typescript": "^5.6.0"
  }
}
