<script>
import { variable } from "lucia";
import Field from "./Field.lucia";
import ReadOnly from "./ReadOnly.lucia";

const name = variable("Ada");
const other = variable("Turing");

function rename() {
  name.value = "Grace";
}
</script>

<p class="name">{name}</p>
<p class="other">{other}</p>
<Field bind-value={name} />
<Field bind={other} />
<ReadOnly label={name} />
<button class="rename" onclick={rename}>Rename</button>
