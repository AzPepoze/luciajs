<script>
import { TRANSITION, EASE, ACTIVE } from "lucia";
const enter = { 0: [TRANSITION.LINEAR, EASE.IN, { opacity: 0 }], 1: [TRANSITION.LINEAR, EASE.IN, { opacity: 1 }] };
const leave = { 0: [TRANSITION.LINEAR, EASE.IN, { transform: "translateX(0px)" }], 1: [TRANSITION.LINEAR, EASE.IN, { transform: "translateX(10px)" }] };
</script>
<p class="box" animate={[{ animation: enter, duration: 100 }, { animation: leave, active: ACTIVE.OUT, duration: 100 }]}>Hi</p>
