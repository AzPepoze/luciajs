{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lusia.config.json",
  "description": "Settings for lusia build, dev, format and lint. Put the file in the app folder. CLI flags override it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "outdir": {
      "type": "string",
      "minLength": 1,
      "description": "Output folder for lusia build. Default: dist"
    },
    "minify": {
      "type": "boolean",
      "description": "Minify the build. Default: true"
    },
    "routes": {
      "type": "array",
      "description": "Client routes that get their own index.html, such as /guide",
      "items": {
        "type": "string",
        "description": "Starts with a slash and has no .."
      }
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Dev server port. Default: 3000"
        }
      }
    },
    "lazy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["smart", "all", "off"],
          "description": "Which imported components load later. Default: smart"
        },
        "prefetch": {
          "enum": ["idle", "view", "none"],
          "description": "When split components start to download. Default: idle"
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lint settings for lusia lint and the editors",
      "properties": {
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "description": "Severity of each lint rule: off hides it, warn shows it, error fails lusia lint",
          "properties": {
            "unused-import": { "enum": ["off", "warn", "error"] },
            "props-twice": { "enum": ["off", "warn", "error"] },
            "unknown-prop": { "enum": ["off", "warn", "error"] },
            "empty-expression": { "enum": ["off", "warn", "error"] },
            "style-attribute": { "enum": ["off", "warn", "error"] },
            "animate-keyframes": { "enum": ["off", "warn", "error"] },
            "animate-key": { "enum": ["off", "warn", "error"] },
            "scroll-numeric-line": { "enum": ["off", "warn", "error"] },
            "flow-chain": { "enum": ["off", "warn", "error"] },
            "bind-target": { "enum": ["off", "warn", "error"] }
          }
        }
      }
    }
  }
}
